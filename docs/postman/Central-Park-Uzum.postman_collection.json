{
  "info": {
    "_postman_id": "34434e17-ad9b-40b9-aec2-6fd077c3c151",
    "name": "Central Park — Uzum Merchant API",
    "description": "Uzum Bank Merchant API webhook collection. Requests are sent by Uzum to the Central Park backend. Run in order: check, create, confirm, status, reverse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{basic_username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{basic_password}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.environment.set('timestamp', String(Date.now()));",
          "if (!String(pm.environment.get('trans_id') || '').trim()) {",
          "  pm.environment.set('trans_id', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — check",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{service_id}},\n  \"timestamp\": {{timestamp}},\n  \"params\": {\n    \"order_id\": \"{{order_id}}\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/check",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "check"
          ]
        },
        "description": "Checks that order_id exists, belongs to an active card and can be paid."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status is OK', () => pm.expect(pm.response.json().status).to.eql('OK'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{service_id}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{trans_id}}\",\n  \"params\": {\n    \"order_id\": \"{{order_id}}\"\n  },\n  \"amount\": {{amount_tiyin}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "create"
          ]
        },
        "description": "Creates the provider transaction. amount is sent in tiyin and must equal the local order amount multiplied by 100."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status is CREATED', () => pm.expect(pm.response.json().status).to.eql('CREATED'));",
              "pm.test('transId matches', () => pm.expect(pm.response.json().transId).to.eql(pm.environment.get('trans_id')));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — confirm",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{service_id}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{trans_id}}\",\n  \"paymentSource\": \"UZCARD\",\n  \"tariff\": null,\n  \"processingReferenceNumber\": \"000\",\n  \"phone\": \"998901234567\",\n  \"cardType\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/confirm",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "confirm"
          ]
        },
        "description": "Confirms payment and atomically credits the park card balance. Repeating confirm returns errorCode 10016 and does not credit twice."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status is CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{service_id}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{trans_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "status"
          ]
        },
        "description": "Returns CREATED, CONFIRMED or REVERSED with transaction timestamps."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status is CONFIRMED', () => pm.expect(pm.response.json().status).to.eql('CONFIRMED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — reverse",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{service_id}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{trans_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/reverse",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "reverse"
          ]
        },
        "description": "Reverses the transaction. For a confirmed payment, the park card must still have enough balance for a full refund."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status is REVERSED', () => pm.expect(pm.response.json().status).to.eql('REVERSED'));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.dev.wonder-walk.uz/api/v1/payments/uzum"
    },
    {
      "key": "basic_username",
      "value": ""
    },
    {
      "key": "basic_password",
      "value": ""
    },
    {
      "key": "service_id",
      "value": "101202"
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "amount_tiyin",
      "value": "1000000"
    },
    {
      "key": "trans_id",
      "value": ""
    },
    {
      "key": "timestamp",
      "value": ""
    }
  ]
}
